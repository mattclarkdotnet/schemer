"""Two generic ICs with adjacent side-face return and signal endpoints."""

RETURN = Ground("RETURN")
SUPPLY = Power("SUPPLY")
LONG_STATUS_A = Net("LONG_STATUS_A")
LONG_STATUS_B = Net("LONG_STATUS_B")


def device(name, status):
    Component(
        name=name,
        prefix="U",
        type="integrated_circuit",
        symbol=Symbol("OrderedPerimeter.kicad_sym", "GENERIC_MODULE"),
        footprint=File("OrderedPerimeter.kicad_mod"),
        part=Part(mpn="GENERIC", manufacturer="Generic"),
        pins={
            "Pin_1": RETURN,
            "Pin_2": SUPPLY,
            "Pin_3": status,
            "Pin_4": NotConnected(),
            "Pin_5": NotConnected(),
            "Pin_6": NotConnected(),
            "Pin_7": NotConnected(),
            "Pin_8": NotConnected(),
        },
    )


device("FIRST", LONG_STATUS_A)
device("SECOND", LONG_STATUS_B)
