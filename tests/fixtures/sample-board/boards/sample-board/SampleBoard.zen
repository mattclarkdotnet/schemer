# pcb:sch DSP_I2S_DOUT.0 x=1843.7100 y=664.9300 rot=270
# pcb:sch DSP_I2S_LRCK.0 x=1843.7100 y=639.5300 rot=270
# pcb:sch DSP_RESET_REQUEST.0 x=1843.7100 y=563.3300 rot=270
# pcb:sch DSP_STATUS.0 x=1843.7100 y=588.7300 rot=270
# pcb:sch J1.J_DIGITAL_ABX.IDC_BOX_HEADER_2X10_RIGHT_ANGLE x=1936.4100 y=501.1000 rot=0
# pcb:sch SCL.0 x=1843.7100 y=512.5300 rot=270
# pcb:sch SDA.0 x=1843.7100 y=537.9300 rot=270
# pcb:sch SPDIF x=0.0000 y=1438.2000 rot=0
# pcb:sch USB x=2497.8200 y=1975.2000 rot=0
