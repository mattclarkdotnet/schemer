        manufacturer="BOOMELE (Boom Precision Elec)",
        datasheet="https://www.lcsc.com/datasheet/lcsc_datasheet_2304140030_BOOMELE-Boom-Precision-Elec-2-54-2-10P_C9144.pdf",
    ),
    symbol=Symbol("./symbols/Connector_Generic.kicad_sym", name="Conn_02x10_Odd_Even"),
    footprint=File("./footprints/IDC-Header_2x10_P2.54mm_Horizontal.kicad_mod"),
    prefix="J",
    pins={
